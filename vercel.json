{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com https://abridmorocco.disqus.com https://disqus.com https://translate.google.com https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src * data: blob:; connect-src 'self' https://www.google-analytics.com https://stats.g.doubleclick.net https://translate.googleapis.com https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-src https://disqus.com https://abdeosalh.gumroad.com https://translate.google.com;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|jpg|jpeg|png|webp|svg|avif|woff2?)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.*\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landing_page.html",
      "destination": "/itinerary-7-day.html",
      "permanent": true
    },
    {
      "source": "/berber_design_pack.html",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/blog-lakes-isli-tislit.html",
      "destination": "/blog-lake-isli.html",
      "permanent": true
    },
    {
      "source": "/fr/blog-lakes-isli-tislit.html",
      "destination": "/fr/blog-lake-isli.html",
      "permanent": true
    },
    {
      "source": "/es/blog-lakes-isli-tislit.html",
      "destination": "/es/blog-lake-isli.html",
      "permanent": true
    },
    {
      "source": "/AbridMoroccoTrip_Booking_System.xlsx",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/content-plan.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(gen_[a-z0-9_]+)\\.py",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(check_enc|gen_build)\\.ps1",
      "destination": "/",
      "permanent": false
    }
  ]
}
